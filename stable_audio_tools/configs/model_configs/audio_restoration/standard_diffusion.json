{
    "model_type": "diffusion_cond_restoration",
    "sample_size": 220500,
    "sample_rate": 44100,
    "audio_channels": 2,
    "max_epochs": 1000,
    "model": {
        "pretransform": {
            "type": "autoencoder",
            "iterate_batch": true,
            "config": {
                "encoder": {
                    "type": "oobleck",
                    "config": {
                        "in_channels": 2,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 4, 4, 8, 8],
                        "latent_dim": 128,
                        "use_snake": true
                    }
                },
                "decoder": {
                    "type": "oobleck",
                    "config": {
                        "out_channels": 2,
                        "channels": 128,
                        "c_mults": [1, 2, 4, 8, 16],
                        "strides": [2, 4, 4, 8, 8],
                        "latent_dim": 64,
                        "use_snake": true,
                        "final_tanh": false
                    }
                },
                "bottleneck": {
                    "type": "vae"
                },
                "latent_dim": 64,
                "downsampling_ratio": 2048,
                "io_channels": 2
            }
        },
        "conditioning": {
            "configs": [
                {
                    "id": "degraded_audio",
                    "type": "pretransform",
                    "config": {
                        "output_dim": 64,
                        "sample_rate": 44100,
                        "use_model_pretransform": true
                    }
                }
            ],
            "cond_dim": 128
        },
        "diffusion": {
            "diffusion_objective": "standard_diffusion",
            "input_concat_ids": ["degraded_audio"],
            "type": "dit",
            "config": {
                "input_concat_dim": 64,
                "io_channels": 64,
                "embed_dim": 1536,
                "depth": 24,
                "num_heads": 24,
                "cond_token_dim": 64,
                "global_cond_dim": 1536,
                "project_cond_tokens": false,
                "transformer_type": "continuous_transformer"
            }
        },
        "io_channels": 64
    },
    "training": {
        "use_ema": true,
        "log_loss_info": false,
        "optimizer_configs": {
            "diffusion": {
                "optimizer": {
                    "type": "AdamW",
                    "config": {
                        "lr": 3e-5,
                        "betas": [0.9, 0.95],
                        "weight_decay": 1e-8
                    }
                },
                "scheduler": {
                    "type": "InverseLR",
                    "config": {
                        "inv_gamma": 2000000,
                        "power": 0.75,
                        "warmup": 0.95
                    }
                }
            }
        },
        "demo": {
            "demo_every": 150,
            "demo_steps": 10,
            "num_demos": 1,
            "demo_cfg_scales": [1]
        }
    }
}